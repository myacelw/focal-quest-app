{
  "name": "focal-quest-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "start": "node scripts/dev-all.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "serve:static": "node scripts/serve-dist.mjs",
    "cf:dev": "wrangler pages dev dist --port 8788",
    "cf:deploy": "wrangler pages deploy dist",
    "lan": "node scripts/serve-lan.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node scripts/test-api.mjs",
    "server": "node --experimental-sqlite server/index.ts",
    "db:migrate:local": "wrangler d1 migrations apply focal-quest-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply focal-quest-db --remote",
    "typecheck:functions": "tsc -p functions/tsconfig.json"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.114.0"
  }
}
