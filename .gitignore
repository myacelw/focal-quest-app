node_modules
dist
*.local
.DS_Store

# vosk 模型：完整 tar.gz 不入库（41MB，超 EdgeOne 单文件 25MiB 上限）；
# 改为入库 <25MB 的分片（*.part00/01/02 + *.parts.json），前端 vosk.ts 拼回。
public/models/*.tar.gz
public/models/vosk-model-small-cn-0.22/

# 本地 SQLite 数据文件（server/），不入库
server/*.db
server/*.db-journal
server/*.db-wal
server/*.db-shm

# 临时构建包（直传用，不入库）
dist.zip

# wrangler pages dev 的本地状态与临时目录，不入库
.wrangler/

# wrangler 本地开发的环境变量（含引导邀请码等本地密钥），绝不入库
.dev.vars

# SDD 执行期的 scratch（账本/任务简报/评审包），不入库
.superpowers/

# Playwright MCP 的调试产物（截图/快照/console 日志），只在本机排查时生成
.playwright-mcp/
